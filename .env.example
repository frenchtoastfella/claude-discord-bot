# Copy to .env and fill in THAT file. This template is committed — never put real values here.

# --- Required ---
# Discord bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional ---
# Admin panel (binds to 127.0.0.1 only). Leave ADMIN_TOKEN empty on a single-user machine;
# set it only if other people have accounts on this box.
ADMIN_PORT=8787
ADMIN_TOKEN=

# Git credentials for a private docs repo. Easiest option: use an HTTPS URL that
# already embeds a token, e.g. https://x-access-token:<PAT>@github.com/org/repo.git
# (set that as the repo URL in the admin panel, not here). Alternatively rely on
# your machine's existing git credential helper / SSH agent.

# Where working data lives (config, docs clone, usage log). Defaults to ./data
# DATA_DIR=D:\repos\claude-discord-bot\data
